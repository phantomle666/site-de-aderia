<!DOCTYPE html>
<html lang="fr" class="dark" style="color-scheme: dark;">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Administration FiveM - Licences</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background: #0c0d0e; color: #f3f4f6; min-height: 100vh; display: flex; flex-direction: column; }
    header { background: #141518; border-bottom: 1px solid #23252a; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
    .logo { font-weight: 700; font-size: 1.1rem; color: #fff; display: flex; align-items: center; gap: 0.5rem; }
    .logo span { color: #6366f1; }
    nav { display: flex; gap: 1.5rem; align-items: center; }
    nav a { color: #9ca3af; text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s; }
    nav a:hover, nav a.active { color: #fff; }
    .user-pill { display: flex; align-items: center; gap: 0.75rem; background: #1d1e22; padding: 0.4rem 0.8rem; border-radius: 20px; font-size: 0.85rem; border: 1px solid #2d2f35; }
    .user-pill .badge { background: #6366f1; color: white; padding: 0.15rem 0.5rem; border-radius: 10px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; }
    .logout-btn { background: none; border: none; color: #ef4444; cursor: pointer; font-size: 0.85rem; font-weight: 500; }
    main { max-width: 1200px; margin: 2rem auto; padding: 0 1.5rem; width: 100%; flex: 1; }
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    h1 { font-size: 1.75rem; font-weight: 700; }
    .btn { background: #6366f1; color: white; border: none; padding: 0.6rem 1.2rem; border-radius: 8px; font-size: 0.9rem; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; }
    .btn:hover { background: #4f46e5; }
    .btn-danger { background: #ef4444; }
    .btn-danger:hover { background: #dc2626; }
    .btn-success { background: #10b981; }
    .btn-success:hover { background: #059669; }
    .btn-secondary { background: #27282d; color: #d1d5db; }
    .btn-secondary:hover { background: #32353b; }
    .btn-sm { padding: 0.35rem 0.65rem; font-size: 0.8rem; border-radius: 6px; }
    .card { background: #18191c; border: 1px solid #27282d; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; }
    .filters { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .filters input, .filters select { background: #101113; border: 1px solid #32353b; border-radius: 8px; padding: 0.5rem 0.8rem; color: #fff; font-size: 0.85rem; outline: none; }
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    th { text-align: left; padding: 0.75rem 0.75rem; color: #9ca3af; font-weight: 600; border-bottom: 1px solid #27282d; }
    td { padding: 0.75rem 0.75rem; border-bottom: 1px solid #202126; color: #d1d5db; vertical-align: middle; }
    .badge-status { padding: 0.2rem 0.5rem; border-radius: 6px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; }
    .badge-active { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .badge-revoked { background: rgba(239, 68, 68, 0.2); color: #f87171; }
    .badge-expired { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
    .key-box { background: rgba(99, 102, 241, 0.15); border: 1px solid #6366f1; color: #c7d2fe; padding: 1.25rem; border-radius: 8px; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; }
    .key-display { font-family: monospace; font-size: 1.25rem; font-weight: 700; color: #fff; letter-spacing: 0.05rem; }
    .actions-group { display: flex; gap: 0.4rem; align-items: center; }
    .form-create { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; align-items: end; }
    .form-create label { display: block; font-size: 0.8rem; color: #9ca3af; margin-bottom: 0.3rem; }
    .form-create input, .form-create select { width: 100%; background: #101113; border: 1px solid #32353b; border-radius: 8px; padding: 0.55rem; color: #fff; font-size: 0.85rem; }
  </style>
</head>
<body>
  <header>
    <div class="logo">
      Panel Admin <span>FiveM</span>
    </div>
    <nav>
      <a href="/admin/dashboard">Vue d'ensemble</a>
      <a href="/admin/licenses" class="active">Licences</a>
      <a href="/admin/audit-logs">Journal d'audit</a>
      <div class="user-pill">
        <span><%= admin.username %></span>
        <span class="badge"><%= admin.role %></span>
        <form method="POST" action="/admin/logout" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="logout-btn">Déconnexion</button>
        </form>
      </div>
    </nav>
  </header>

  <main>
    <div class="top-bar">
      <h1>Gestion des Licences</h1>
    </div>

    <% if (createdKey) { %>
      <div class="key-box">
        <div>
          <div style="font-size: 0.85rem; margin-bottom: 0.25rem;">🎉 Nouvelle licence générée avec succès pour <strong><%= createdKey.product %></strong> :</div>
          <div class="key-display" id="newKey"><%= createdKey.plainKey %></div>
        </div>
        <button class="btn btn-secondary btn-sm" onclick="navigator.clipboard.writeText('<%= createdKey.plainKey %>'); alert('Clé copiée !');">Copier</button>
      </div>
    <% } %>

    <!-- Formulaire de création manuelle -->
    <div class="card">
      <h3 style="font-size: 1rem; margin-bottom: 1rem;">Créer une licence manuellement</h3>
      <form method="POST" action="/admin/licenses/create" class="form-create">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        
        <div>
          <label>Produit / Base</label>
          <input type="text" name="product" placeholder="ex: Base aderia V2" required>
        </div>

        <div>
          <label>Type</label>
          <select name="type" id="typeSelect" onchange="toggleDuration(this.value)">
            <option value="standard">Standard (jours)</option>
            <option value="lifetime">Lifetime (Illimité)</option>
            <option value="gift">Cadeau / Gift</option>
          </select>
        </div>

        <div id="durationGroup">
          <label>Durée (jours)</label>
          <input type="number" name="duration_days" value="30" min="1">
        </div>

        <div>
          <label>Max serveurs (IPs)</label>
          <input type="number" name="max_servers" value="1" min="1" required>
        </div>

        <div>
          <label>Note client</label>
          <input type="text" name="note" placeholder="ex: ami Julien">
        </div>

        <div>
          <button type="submit" class="btn" style="width: 100%;">Générer la clé</button>
        </div>
      </form>
    </div>

    <!-- Filtres et recherche -->
    <div class="card">
      <form method="GET" action="/admin/licenses" class="filters">
        <input type="text" name="search" placeholder="Recherche (clé ou note)..." value="<%= query.search || '' %>">
        <select name="status">
          <option value="">Tous les statuts</option>
          <option value="active" <%= query.status === 'active' ? 'selected' : '' %>>Actives</option>
          <option value="revoked" <%= query.status === 'revoked' ? 'selected' : '' %>>Révoquées</option>
          <option value="expired" <%= query.status === 'expired' ? 'selected' : '' %>>Expirées</option>
        </select>
        <button type="submit" class="btn btn-secondary btn-sm">Filtrer</button>
        <% if (query.search || query.status) { %>
          <a href="/admin/licenses" class="btn btn-secondary btn-sm">Réinitialiser</a>
        <% } %>
      </form>

      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Clé Masquée</th>
            <th>Produit</th>
            <th>Type</th>
            <th>Statut</th>
            <th>Serveurs (IPs)</th>
            <th>Expiration</th>
            <th>Note</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!licenses || licenses.length === 0) { %>
            <tr><td colspan="9" style="text-align: center; color: #6b7280; padding: 2rem;">Aucune licence trouvée.</td></tr>
          <% } else { %>
            <% licenses.forEach(lic => { %>
              <tr>
                <td>#<%= lic.id %></td>
                <td>
                  <code id="key-<%= lic.id %>" data-masked="<%= lic.masked_key %>" data-full="<%= lic.decrypted_key || lic.masked_key %>"><%= lic.masked_key %></code>
                  <button class="btn btn-secondary btn-sm" style="margin-left: 6px; padding: 2px 8px; font-size: 0.72rem;" onclick="toggleKeyDisplay(<%= lic.id %>, this)">Voir</button>
                </td>
                <td><strong><%= lic.product %></strong></td>
                <td><%= lic.type %></td>
                <td>
                  <% if (lic.status === 'active') { %>
                    <span class="badge-status badge-active">Active</span>
                  <% } else if (lic.status === 'revoked') { %>
                    <span class="badge-status badge-revoked">Révoquée</span>
                  <% } else { %>
                    <span class="badge-status badge-expired">Expirée</span>
                  <% } %>
                </td>
                <td><%= lic.bound_ips || 0 %> / <%= lic.max_servers %></td>
                <td><%= lic.expires_at ? new Date(lic.expires_at).toLocaleDateString('fr-FR') : '♾️ Lifetime' %></td>
                <td><small><%= lic.note || '-' %></small></td>
                <td>
                  <div class="actions-group">
                    <% if (lic.status === 'active') { %>
                      <form method="POST" action="/admin/licenses/<%= lic.id %>/revoke" style="display:inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Révoquer cette licence ?');">Révoquer</button>
                      </form>
                    <% } else { %>
                      <form method="POST" action="/admin/licenses/<%= lic.id %>/reactivate" style="display:inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-success btn-sm">Réactiver</button>
                      </form>
                    <% } %>

                    <form method="POST" action="/admin/licenses/<%= lic.id %>/reset-ips" style="display:inline;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-secondary btn-sm" title="Réinitialiser les serveurs autorisés">Reset IP</button>
                    </form>

                    <form method="POST" action="/admin/licenses/<%= lic.id %>/extend" style="display:inline;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="days" value="30">
                      <button type="submit" class="btn btn-secondary btn-sm" title="+30 jours">+30j</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    function toggleDuration(type) {
      document.getElementById('durationGroup').style.display = (type === 'lifetime') ? 'none' : 'block';
    }

    function toggleKeyDisplay(id, btn) {
      const codeEl = document.getElementById('key-' + id);
      if (!codeEl) return;

      const masked = codeEl.getAttribute('data-masked');
      const full = codeEl.getAttribute('data-full');

      if (codeEl.innerText === masked) {
        // Révéler la clé
        codeEl.innerText = full;
        codeEl.style.color = '#34d399';
        codeEl.style.fontWeight = 'bold';
        btn.innerText = 'Copier';
        btn.classList.remove('btn-secondary');
        btn.classList.add('btn-success');
      } else {
        // Copier dans le presse-papier
        navigator.clipboard.writeText(full).then(() => {
          const prev = btn.innerText;
          btn.innerText = 'Copié !';
          setTimeout(() => { btn.innerText = prev; }, 1500);
        }).catch(() => {
          alert('Clé : ' + full);
        });
      }
    }
  </script>
</body>
</html>
