<!DOCTYPE html>
<html lang="fr" class="dark" style="color-scheme: dark;">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Administration FiveM - Journal d'Audit</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background: #0c0d0e; color: #f3f4f6; min-height: 100vh; display: flex; flex-direction: column; }
    header { background: #141518; border-bottom: 1px solid #23252a; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
    .logo { font-weight: 700; font-size: 1.1rem; color: #fff; display: flex; align-items: center; gap: 0.5rem; }
    .logo span { color: #6366f1; }
    nav { display: flex; gap: 1.5rem; align-items: center; }
    nav a { color: #9ca3af; text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s; }
    nav a:hover, nav a.active { color: #fff; }
    .user-pill { display: flex; align-items: center; gap: 0.75rem; background: #1d1e22; padding: 0.4rem 0.8rem; border-radius: 20px; font-size: 0.85rem; border: 1px solid #2d2f35; }
    .user-pill .badge { background: #6366f1; color: white; padding: 0.15rem 0.5rem; border-radius: 10px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; }
    .logout-btn { background: none; border: none; color: #ef4444; cursor: pointer; font-size: 0.85rem; font-weight: 500; }
    main { max-width: 1200px; margin: 2rem auto; padding: 0 1.5rem; width: 100%; flex: 1; }
    h1 { font-size: 1.75rem; font-weight: 700; margin-bottom: 1.5rem; }
    .card { background: #18191c; border: 1px solid #27282d; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; }
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    th { text-align: left; padding: 0.75rem; color: #9ca3af; font-weight: 600; border-bottom: 1px solid #27282d; }
    td { padding: 0.75rem; border-bottom: 1px solid #202126; color: #d1d5db; vertical-align: top; }
    pre { font-family: monospace; font-size: 0.75rem; background: #101113; padding: 0.4rem; border-radius: 4px; color: #a5b4fc; max-width: 300px; overflow-x: auto; }
  </style>
</head>
<body>
  <header>
    <div class="logo">
      Panel Admin <span>FiveM</span>
    </div>
    <nav>
      <a href="/admin/dashboard">Vue d'ensemble</a>
      <a href="/admin/licenses">Licences</a>
      <a href="/admin/audit-logs" class="active">Journal d'audit</a>
      <div class="user-pill">
        <span><%= admin.username %></span>
        <span class="badge"><%= admin.role %></span>
        <form method="POST" action="/admin/logout" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="logout-btn">Déconnexion</button>
        </form>
      </div>
    </nav>
  </header>

  <main>
    <h1>Journal d'Audit des Actions Administrateur</h1>
    <div class="card">
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Admin</th>
            <th>Action</th>
            <th>Cible</th>
            <th>IP Admin</th>
            <th>Avant / Après</th>
          </tr>
        </thead>
        <tbody>
          <% if (!logs || logs.length === 0) { %>
            <tr><td colspan="6" style="text-align: center; color: #6b7280; padding: 2rem;">Aucun enregistrement d'audit.</td></tr>
          <% } else { %>
            <% logs.forEach(log => { %>
              <tr>
                <td><%= new Date(log.created_at).toLocaleString('fr-FR') %></td>
                <td><strong><%= log.admin_username %></strong></td>
                <td><code><%= log.action %></code></td>
                <td><%= log.target_type %> #<%= log.target_id || '-' %></td>
                <td><%= log.ip_address %></td>
                <td>
                  <% if (log.after_state) { %>
                    <pre><%= JSON.stringify(log.after_state, null, 2) %></pre>
                  <% } else { %>
                    -
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
